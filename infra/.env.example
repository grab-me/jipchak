# =====================================================================
# 인프라 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 수정하세요.
#   cp .env.example .env
# .env 는 .gitignore 처리되어 있으므로 커밋되지 않습니다.
# =====================================================================

# --- Database (MySQL) ---
# 프로덕션에서는 root 대신 별도 계정 사용 권장
DB_HOST=db-jipchak
DB_USERNAME=changeme
DB_PASSWORD=changeme
DB_PORT=3306

# --- Redis ---
REDIS_HOST=redis-jipchak
REDIS_PORT=6379

# --- 서비스 포트 매핑 ---
BACKEND_PORT=8108
AI_PORT=8001
FRONTEND_PORT=3001

# --- Jenkins ---
JENKINS_PORT=8081
JENKINS_AGENT_PORT=50001

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- 영상 저장 ---
HOST_VIDEO_DIR=./videos

# --- Spring Boot 멀티파트 한도 ---
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB
